# Anthropic API key. Without it the server boots in stub-translation mode
# (messages are passed through with a [th->en] marker) so you can develop the
# UI and the realtime layer without spending anything.
ANTHROPIC_API_KEY=

# Translation model. Opus 5 gives the best colloquial Thai; claude-sonnet-5 is
# the cheaper option if you are sending a lot of traffic.
TRANSLATION_MODEL=claude-opus-5

# low | medium | high | xhigh | max -- how much the model deliberates per
# message. Chat wants latency, so "low" is the default.
TRANSLATION_EFFORT=low

# HTTP + WebSocket port
PORT=8787

# Where the SQLite file lives. ":memory:" keeps nothing between restarts.
DATABASE_PATH=./data/chat.sqlite

# Comma-separated origins allowed to talk to the API in development.
CORS_ORIGINS=http://localhost:5173

# Per-connection send limit (messages per minute) -- your spend guard.
RATE_LIMIT_PER_MINUTE=30
